# ─── Server ───────────────────────────────────────────────
PORT = 8000

# Set to "production" on your live host (enables Secure cookies, HSTS,
# and disables the dev-only mock-payment / unverified-auth fallbacks).
NODE_ENV = development

# MongoDB Atlas connection string
MONGODB_URI = mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT secret — generate a random 256-bit hex string
JWT_SECRET = <your-jwt-secret>

# Google Gemini API key (1.5 Flash)
GEMINI_API_KEY = <your-gemini-api-key>

# OpenRouter fallback — 100% free fallback models (e.g. google/gemini-2.0-flash-exp:free, meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY = <your-openrouter-api-key>
OPENROUTER_MODEL = google/gemini-2.0-flash-exp:free
OPENROUTER_URL = https://openrouter.ai/api/v1/chat/completions
OPENROUTER_ENABLED = true
FALLBACK_ENABLED = true
# Quality-repair passes automatically use the other configured provider.
CIRCUIT_BREAKER_THRESHOLD = 3
CIRCUIT_BREAKER_COOLDOWN_MS = 120000

# Client origin for CORS — update when deploying to production
CLIENT_URL = http://localhost:5173

# Razorpay — leave BOTH blank for mock payments, fill in to enable live payments
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID =
RAZORPAY_KEY_SECRET =

# Firebase Admin — REQUIRED in production to verify Google sign-in tokens.
# Without this the server cannot prove who is signing in, so /googleAuth is
# refused in production. Paste the service-account JSON as a single line, OR
# instead set GOOGLE_APPLICATION_CREDENTIALS to the path of the JSON file.
# Download from Firebase console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT =
# GOOGLE_APPLICATION_CREDENTIALS = /path/to/service-account.json
