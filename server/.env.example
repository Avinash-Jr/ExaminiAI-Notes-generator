# ─── Server ───────────────────────────────────────────────
PORT = 8000

# MongoDB Atlas connection string
MONGODB_URI = mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT secret — generate a random 256-bit hex string
JWT_SECRET = <your-jwt-secret>

# Google Gemini API key (1.5 Flash)
GEMINI_API_KEY = <your-gemini-api-key>

# Grok (xAI) fallback — used when Gemini is rate-limited or unavailable
GROK_API_KEY = <your-grok-api-key>
GROK_MODEL = grok-3-mini-fast
GROK_URL = https://api.x.ai/v1/chat/completions
FALLBACK_ENABLED = true
CIRCUIT_BREAKER_THRESHOLD = 3
CIRCUIT_BREAKER_COOLDOWN_MS = 120000

# Client origin for CORS — update when deploying to production
CLIENT_URL = http://localhost:5173

# Razorpay — leave BOTH blank for mock payments, fill in to enable live payments
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID =
RAZORPAY_KEY_SECRET =
